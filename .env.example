# Bridge configuration
# Copy this file to .env and customize as needed.
# Bridge works with all defaults — nothing here is required.
#
# Note: BRIDGE_DRIVE_DIR is the old name for BRIDGE_DATA_DIR and still works,
# but is deprecated. Please rename to BRIDGE_DATA_DIR in your .env.

# Port the daemon listens on (HTTP server for MCP)
BRIDGE_PORT=7777

# Where bridge stores project data (briefs and results)
# Default: a local Bridge folder in your home directory (works with no setup).
# You can point this at any folder — including a cloud-synced one (Google Drive,
# Dropbox, OneDrive, iCloud) if you want briefs and results to sync between
# devices. Storage backend is your choice; bridge just reads and writes files.
#
# Local example (commented out — this is the default):
# BRIDGE_DATA_DIR=C:\Users\YourName\Bridge
#
# Google Drive example (commented out):
# BRIDGE_DATA_DIR=G:\My Drive\bridge

# Project paths: JSON object mapping project names to their absolute paths
# Used by bridge_review to locate the codebase for each project when reading files
# Example for Windows:
# BRIDGE_PROJECT_PATHS={"Nova":"C:\\Users\\YourName\\Documents\\AI\\Nova","bridge":"C:\\Users\\YourName\\Documents\\AI\\bridge"}
# BRIDGE_PROJECT_PATHS=

# Project root for the stdio entrypoint (npm run bridge:stdio)
# Used to override the project root that bridge_review uses for file reads
# when bridge is spawned as a subprocess (e.g. by Claude Desktop's MCP config).
# Defaults to the current working directory if not set.
# BRIDGE_PROJECT_ROOT=C:\\Users\\YourName\\Documents\\YourProject

# Log level: error | warn | info | debug
LOG_LEVEL=info
